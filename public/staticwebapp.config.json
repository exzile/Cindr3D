{
  "routes": [
    {
      "route": "/",
      "redirect": "/home",
      "statusCode": 302
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.js", "/*.css", "/*.ico", "/*.png", "/*.svg", "/robots.txt", "/sitemap.xml"]
  },
  "mimeTypes": {
    ".wasm": "application/wasm"
  }
}
